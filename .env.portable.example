# Copy this file to .env.portable or run scripts/bootstrap-portable.ps1.
# Never commit the generated .env.portable file.

BINIX_DB_NAME=binix
BINIX_DB_USER=binix
BINIX_DB_PASSWORD=replace-with-a-long-hex-password
BINIX_DB_HOST_PORT=15432

BINIX_WEB_PORT=4000
BINIX_SEED_SUPER_ADMIN_PHONE=09123456789
BINIX_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Mock OTP is for local development only. The development code is 12345.
BINIX_OTP_DRIVER=mock
BINIX_RUNTIME_ENV=local
BINIX_PAYMENT_TEST_MODE=true
# Keep this false unless you explicitly want local checkout to show real gateways.
BINIX_LOCAL_REAL_PAYMENT=false
BINIX_SESSION_COOKIE_NAME=binix_session
BINIX_SESSION_TTL_DAYS=30
