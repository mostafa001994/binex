  ctaClicks       Int      @default(0) @map("cta_clicks")
  uniqueCtaClicks Int      @default(0) @map("unique_cta_clicks")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  post BlogPost @relation(fields:[postId], references:[id], onDelete:Cascade)

  @@unique([postId,date])
  @@index([date])
  @@map("blog_post_daily_metrics")
}


model BlogPostAnalyticsVisitor {
  id          String             @id @default(uuid()) @db.Uuid
  postId      String             @map("post_id") @db.Uuid
  date        DateTime           @db.Date
  event       BlogAnalyticsEvent
  visitorHash String             @map("visitor_hash") @db.Char(64)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  post BlogPost @relation(fields:[postId], references:[id], onDelete:Cascade)

  @@unique([postId,date,event,visitorHash])
  @@index([date])
  @@map("blog_post_analytics_visitors")
}


model BlogContentSource {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  url         String   @db.VarChar(2048)
  title       String?  @db.VarChar(300)
  publisher   String?  @db.VarChar(200)
  licenseNote String?  @map("license_note") @db.VarChar(500)
  retrievedAt DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)

  post BlogPost @relation(fields:[postId], references:[id], onDelete:Cascade)

  @@unique([postId,url])
  @@index([postId])
  @@map("blog_content_sources")
}
