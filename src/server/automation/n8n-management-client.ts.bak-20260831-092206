type JsonObject = Record<string, unknown>;

export type N8nWorkflow = {
  id: string;
  name: string;
  active: boolean;
  versionId?: string;
  nodes: unknown[];
  connections: JsonObject;
  settings: JsonObject;
  staticData?: unknown;
  pinData?: JsonObject | null;
  nodeGroups?: unknown[];
};

export type N8nWorkflowWritePayload = {
  name: string;
  nodes: unknown[];
  connections: JsonObject;
  settings: JsonObject;
  staticData?: unknown;
  pinData?: JsonObject | null;
  nodeGroups?: unknown[];
  projectId?: string;
  parentFolderId?: string | null;
};

function getConfig() {
  const baseUrl = process.env.N8N_BASE_URL?.replace(/\/+$/, "");
  const apiKey = process.env.N8N_API_KEY;

  if (!baseUrl) {
    throw new Error("N8N_BASE_URL is not configured");
  }

  if (!apiKey) {
    throw new Error("N8N_API_KEY is not configured");
  }

  return {
    apiUrl: `${baseUrl}/api/v1`,
    apiKey,
  };
}

function safeErrorMessage(value: unknown) {
  if (typeof value !== "string") {
    return "Unknown n8n API error";
  }

  return value
    .replace(/https?:\/\/[^\s"'<>]+/gi, "[url]")
    .replace(/\b(?:ck|cs)_[A-Za-z0-9_-]+\b/g, "[credential]")
    .replace(/bot[A-Za-z0-9:_-]{12,}/gi, "bot[redacted]")
    .slice(0, 500);
}

async function request<T>(
  path: string,
  init: RequestInit = {},
): Promise<T> {
  const { apiUrl, apiKey } = getConfig();

  const response = await fetch(`${apiUrl}${path}`, {
    ...init,
    headers: {
      Accept: "application/json",
      "X-N8N-API-KEY": apiKey,
      ...(init.body ? { "Content-Type": "application/json" } : {}),
      ...(init.headers ?? {}),
    },
    cache: "no-store",
  });

  const text = await response.text();

  let body: unknown = null;

  if (text) {
    try {
      body = JSON.parse(text);
    } catch {
      body = text;
    }
  }

  if (!response.ok) {
    const message =
      body &&
      typeof body === "object" &&
      "message" in body &&
      typeof (body as { message?: unknown }).message === "string"
        ? (body as { message: string }).message
        : text || `HTTP ${response.status}`;

    throw new Error(
      `n8n API ${response.status}: ${safeErrorMessage(message)}`,
    );
  }

  return body as T;
}

export function buildClonePayload(
  template: N8nWorkflow,
  name: string,
): N8nWorkflowWritePayload {
  return {
    name,
    nodes: structuredClone(template.nodes ?? []),
    connections: structuredClone(template.connections ?? {}),
    settings: structuredClone(template.settings ?? {}),
    staticData: null,
    pinData: {},
    ...(Array.isArray(template.nodeGroups)
      ? { nodeGroups: structuredClone(template.nodeGroups) }
      : {}),
  };
}

export async function getN8nWorkflow(
  workflowId: string,
): Promise<N8nWorkflow> {
  return request<N8nWorkflow>(
    `/workflows/${encodeURIComponent(workflowId)}`,
  );
}

export async function createN8nWorkflow(
  payload: N8nWorkflowWritePayload,
): Promise<N8nWorkflow> {
  return request<N8nWorkflow>("/workflows", {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

export async function updateN8nWorkflow(
  workflowId: string,
  payload: N8nWorkflowWritePayload,
): Promise<N8nWorkflow> {
  // n8n accepts project/folder placement when creating a workflow,
  // but these are not writable workflow properties on PUT.
  const {
    projectId: _projectId,
    parentFolderId: _parentFolderId,
    ...updatePayload
  } = payload;

  return request<N8nWorkflow>(
    `/workflows/${encodeURIComponent(workflowId)}`,
    {
      method: "PUT",
      body: JSON.stringify(updatePayload),
    },
  );
}

export async function activateN8nWorkflow(
  workflowId: string,
  versionId?: string,
): Promise<N8nWorkflow> {
  return request<N8nWorkflow>(
    `/workflows/${encodeURIComponent(workflowId)}/activate`,
    {
      method: "POST",
      body: JSON.stringify(
        versionId
          ? { versionId }
          : {},
      ),
    },
  );
}

export async function deactivateN8nWorkflow(
  workflowId: string,
): Promise<N8nWorkflow> {
  return request<N8nWorkflow>(
    `/workflows/${encodeURIComponent(workflowId)}/deactivate`,
    {
      method: "POST",
    },
  );
}

export async function deleteN8nWorkflow(
  workflowId: string,
): Promise<unknown> {
  return request(
    `/workflows/${encodeURIComponent(workflowId)}`,
    {
      method: "DELETE",
    },
  );
}

export type N8nDataTableColumnType =
  | "string"
  | "number"
  | "boolean"
  | "date"
  | "json";

export type N8nDataTableColumn = {
  name: string;
  type: N8nDataTableColumnType;
};

export type N8nDataTable = {
  id: string;
  name: string;
  projectId?: string;
  columns?: Array<{
    id?: string;
    name?: string;
    type?: string;
  }>;
};

