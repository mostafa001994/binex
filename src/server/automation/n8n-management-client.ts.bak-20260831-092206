export async function createN8nDataTable(input: {
  name: string;
  columns: N8nDataTableColumn[];
  projectId?: string;
}): Promise<N8nDataTable> {
  const payload: {
    name: string;
    columns: N8nDataTableColumn[];
    projectId?: string;
  } = {
    name: input.name,
    columns: input.columns,
  };

  if (input.projectId) {
    payload.projectId = input.projectId;
  }

  return request<N8nDataTable>(
    "/data-tables",
    {
      method: "POST",
      body: JSON.stringify(payload),
    },
  );
}

export async function getN8nDataTable(
  dataTableId: string,
): Promise<N8nDataTable> {
  return request<N8nDataTable>(
    `/data-tables/${encodeURIComponent(dataTableId)}`,
  );
}

export async function deleteN8nDataTable(
  dataTableId: string,
): Promise<void> {
  await request<unknown>(
    `/data-tables/${encodeURIComponent(dataTableId)}`,
    {
      method: "DELETE",
    },
  );
}
